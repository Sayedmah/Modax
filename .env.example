# Copy to .env and export explicitly; the application does not auto-load .env.
MODAX_DATA_DIR=var
MODAX_ALLOW_SIGNUP=false
MODAX_DEMO=true
# Only configure authorized operators' endpoints. Remote endpoints require HTTPS.
MODAX_PROVIDER_URL=
MODAX_PROVIDER_KEY=
MODAX_PROVIDER_MODEL=
MODAX_OLLAMA_URL=
MODAX_OLLAMA_MODEL=
MODAX_GODOT_BINARY=godot
# Dedicated worker only. Never mount Docker socket into a public API container.
MODAX_DOCKER_TESTS=false
# An immutable operator-approved image e.g. python@sha256:<verified 64-char digest>.
MODAX_TEST_IMAGE=
MODAX_COMFY_URL=
