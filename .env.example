# Copy to .env and export explicitly; the application does not auto-load .env.
MODAX_DATA_DIR=var
MODAX_ALLOW_SIGNUP=false
MODAX_DEMO=true
# Optional direct entry with isolated browser guest sessions; no shared owner.
MODAX_GUEST_MODE=false
# Only configure authorized operators' endpoints. Remote endpoints require HTTPS.
MODAX_PROVIDER_URL=
MODAX_PROVIDER_KEY=
MODAX_PROVIDER_MODEL=
# Optional server-owned Gemini and OpenRouter connections. Choose an available model ID.
GEMINI_API_KEY=
MODAX_GEMINI_MODEL=
OPENROUTER_API_KEY=
MODAX_OPENROUTER_MODEL=
MODAX_OLLAMA_URL=
MODAX_OLLAMA_MODEL=
MODAX_GODOT_BINARY=godot
# Dedicated worker only. Never mount Docker socket into a public API container.
MODAX_DOCKER_TESTS=false
# An immutable operator-approved image e.g. python@sha256:<verified 64-char digest>.
MODAX_TEST_IMAGE=
MODAX_COMFY_URL=

# PostgreSQL connection URL from your own authorized database; empty = local SQLite.
DATABASE_URL=
# Fernet key generated by operator and kept only in hosted secrets.
MODAX_SECRET_KEY=
# Use managed to acquire checksum-pinned official Godot for trusted templates.
# MODAX_GODOT_BINARY=managed
# Optional authorized SearXNG HTTPS instance with JSON output enabled.
# Search queries require explicit per-query consent; leave blank to disable.
MODAX_SEARXNG_URL=
# Optional shared gateway token, server-only. Never put it in the browser.
MODAX_SEARXNG_TOKEN=
